; parsing as zero
eval (RD1 0x7f 0)
; expect: 127
eval (RD1 0x80 0)
; expect: ERR(Exception: 0x73696e676c65746f6e3a20766172696e74)
eval (RD1 0x7f 5)
; expect: ERR(Exception: 0x73696e676c65746f6e3a20766172696e74)

