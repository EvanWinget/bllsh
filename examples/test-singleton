
; test-singleton - Chia's singleton top layer, ported to symbll
;
; Source: puzzles/singleton_top_layer_v1_1.clsp from
; Chia-Network/chia_puzzles release 0.20.3
; (d122456feeef55708d354a065623037bfa010714). A singleton is a
; transaction chain with exactly one live UTXO at its tip. Each spend
; proves the spent output descends from a unique genesis outpoint and
; recreates exactly one successor at the same script, or retires the
; chain. An inner program authorizes each spend.
;
; Block map from the source to this port:
;   SINGLETON_STRUCT (MOD_HASH LAUNCHER_ID . LAUNCHER_PUZZLE_HASH) ->
;     PROGHASH, the leaf hash of this program, and GENESIS, the
;     36 byte outpoint consumed by the launch transaction
;   INNER_PUZZLE and inner_solution -> INNER and IARGS
;   lineage_proof, both shapes -> PROOF, PROOF2 and PIDX, revealed
;     transaction bytes in place of claimed coin id components
;   my_amount and ASSERT_MY_AMOUNT -> (tx 15), introspected directly
;   assert odd my_amount -> ODD8 over (tx 15)
;   calculate_full_puzzle_hash, puzzle-hash-of-curried-function ->
;     MYPROG, TAPROOT binding PROGHASH to the spent scriptPubKey
;   calculate_coin_id and verify_lineage_proof -> LINEAGE, hash256
;     pinning PROOF to (tx 11), then the genesis or ancestry branch
;   is_odd_create_coin, check_and_morph_conditions_for_singleton ->
;     ODDSCAN and INSCAN over the transaction's real outputs and
;     inputs
;   morph_condition -> CONT2, successor scriptPubKey identity
;   melt (the odd CREATE_COIN of -113) -> the retire mode, zero odd
;     outputs
;   (a INNER_PUZZLE inner_solution) -> (a INNER IARGS)
;   singleton_launcher.clsp -> not ported, the genesis outpoint plus
;     the LINEAGE genesis branch replace it, see deviation 4
;
; Deviations, each with its reason:
;   1. Curried constants become argument tree entries. Nothing binds
;      the argument tree before the witness commitment layout exists,
;      a known gap shared by the whole corpus. PROGHASH is partly
;      bound anyway: MYPROG requires it to equal the executing leaf
;      (tx 6). The further reconstruction of the spent scriptPubKey
;      is consensus redundant under BIP341 and pins only the harness
;      context's self consistency.
;   2. Conditions become direct tx assertions and the inner program
;      returns truthy instead of a condition list, following the p2d
;      port. The inner program here verifies a signature over the
;      whole transaction through bip342_txmsg.
;   3. The lineage proof reveals whole transactions instead of coin id
;      components. Outpoints do not carry scriptPubKeys, so proving
;      the parent spent a singleton output needs the grandparent
;      transaction as well: PROOF must hash to my prevout txid
;      (tx 11), PROOF2 must hash to the txid in PROOF's input PIDX,
;      and PROOF2's output named there must be an odd output at my
;      scriptPubKey. The induction assumes this scriptPubKey is
;      spendable only through this leaf, that is a provably unusable
;      internal key and a single leaf tree, which the program cannot
;      check from inside. These test contexts use an ordinary internal
;      key.
;   4. The launcher puzzle and its announcement are not ported. Chia
;      needs the launcher to break a hash circularity and to announce
;      the created singleton. Here the genesis spend proves its parent
;      transaction consumed the committed GENESIS outpoint at input 0
;      and that the spent output sits at index 0, and the funder
;      verifies the launch transaction they sign. No-double-spend of
;      the GENESIS outpoint makes the genesis output unique.
;   5. morph_condition's curried puzzle hash wrapping collapses to
;      scriptPubKey identity: the successor must pay to exactly the
;      spent scriptPubKey. The inner program is not committed before
;      the witness commitment layout exists, so inner transitions have
;      no meaning yet. Revisit at the commitment layout design.
;   6. Retire replaces the melt sentinel, the odd CREATE_COIN of
;      amount -113. A spend with zero odd outputs retires the chain.
;      This fails open where Chia fails closed: absence is consent
;      here, so the inner program must cover the outputs with its
;      signature, as this one does through bip342_txmsg.
;   7. The odd output scan is transaction wide where Chia scans one
;      coin's conditions. Stricter: every non-successor output must be
;      even. INSCAN closes the two-singleton collapse this opens, no
;      other input may be an odd output at my scriptPubKey.
;   8. Amounts and index fields are raw fixed width little endian, not
;      minimal integers. Parity reads the low byte through ODD8,
;      counters normalize through (+ X 0), and equality against
;      (tx 12) uses the width matched literal 0x00000000.
;   9. Proof parsing accepts only canonical single byte counts below
;      0x80, enforced by RD1. Descendants of transactions with 128 or
;      more inputs or outputs are unspendable, a recorded restriction.
;  10. The apply surface takes exactly two operands, and the inner
;      program is written in numeric bll opcodes, both following the
;      p2d port.
;
; All hex constants below were produced by
;   python3 examples/gen-test-context.py singleton
; The launch chain is genesis outpoint -> launch tx -> context A ->
; context B, and contexts C through H respend context B's successor in
; mutually exclusive hypotheticals.
;
; Run with
;   python3 examples/run-examples.py examples/test-singleton
; which checks every "; expect:" marker below, or interactively with
;   echo "import examples/test-singleton" | ./bllsh

; -------------------------------------------------------------------
; shared taproot helpers, one vetted copy for the whole corpus

import examples/lib-taproot

; -------------------------------------------------------------------
; the argument tree constants

def PROGHASH 0x4aa38da757f40e7a612fd0759926ceb9f120b4195dbdb948b6f44749d06305b1
def GENESIS 0x000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f00000000
; the inner program is (bip340_verify PK (bip342_txmsg) 1) with 1 the
; whole environment, the 64 byte signature
def INNER (q 38 (0 . 0x463b3d9f662621fb1b4be8fbbe2520125a216cdfc9dae3debcba4850c690d45b) (42) 1)

; -------------------------------------------------------------------
; the singleton program

; parity of a raw 8 byte little endian amount. Non-empty zero atoms
; are truthy, so the low byte is masked and compared byte exactly,
; and the empty atom is refused rather than misread as odd, the &
; fold passes an operand through when the other side is empty.
def (ODD8 A) (all (strlen A) (= (& (substr A 0 1) 1) 1))

; the program hash argument must be the executing leaf. The
; reconstruction of the spent scriptPubKey from (tx 9)'s parity bit,
; the merkle path and the internal key is consensus redundant, BIP341
; already verified the same equation to let this leaf run, but before
; the commitment layout exists nothing else ties the harness context's
; witness fields together, so it pins their self consistency here. The
; muladd inside TAPROOT raises on a mismatch.
def (MYPROG PROGHASH) (if (= PROGHASH (tx 6)) (TAPROOT (t (tx 9)) PROGHASH (tx 8) (tx 7) (CHECKTAPSPK (tx 16))))

; a single byte count or length read from revealed transaction bytes,
; canonical form only: exactly one byte, below 0x80, returned as a
; minimal int. An out of range read yields the empty atom from substr
; and must raise, not parse as zero.
def (RD1B B) (if (all (<s B 0x80) (strlen B)) (+ B 0) (x "singleton: varint"))
def (RD1 P POS) (RD1B (substr P POS (+ POS 1)))

; cursor arithmetic over a serialized transaction without witness:
; an input is a 36 byte outpoint, a length prefixed scriptSig and a
; 4 byte sequence, an output is an 8 byte value and a length prefixed
; scriptPubKey
def (SKIPINS P C N) (if N (SKIPINS P (+ C 41 (RD1 P (+ C 36))) (- N 1)) C)
def (PREVOUTAT P C) (substr P C (+ C 36))
def (OUTPOS P C N) (if N (OUTPOS P (+ C 9 (RD1 P (+ C 8))) (- N 1)) C)

; the output at cursor C is an odd output at my scriptPubKey
def (SGLOUT P C) (all (= (substr P (+ C 9) (+ C 9 (RD1 P (+ C 8)))) (tx 16)) (ODD8 (substr P C (+ C 8))))

; the grandparent's output named by outpoint OP is an odd output at
; my scriptPubKey. C is the position of P2's output count byte. The
; index bound keeps the OUTPOS recursion below the RD1 ceiling, a
; witness supplied counter must never drive an unbounded walk.
def (ANCESTRY3 P2 OPN C) (if (all (< -1 OPN) (< OPN (RD1 P2 C))) (SGLOUT P2 (OUTPOS P2 (+ C 1) OPN)))

; only a P2 that hashes to the outpoint's txid is parsed at all, the
; lazy if keeps every cursor walk on hash verified bytes
def (ANCESTRY2 P2 OP) (if (= (hash256 P2) (substr OP 0 32)) (ANCESTRY3 P2 (+ (substr OP 32 36) 0) (SKIPINS P2 5 (RD1 P2 4))))

; the parent's input J spent an odd output at my scriptPubKey, proven
; by revealing the grandparent transaction. J is witness supplied, so
; it is bounded by the input count and re-encoded minimally before it
; drives SKIPINS, whose countdown ends on the empty atom: a
; non-minimal zero would pass the numeric bound yet never count down.
def (ANCESTRY P P2 J) (if (all (< -1 J) (< J (RD1 P 4))) (ANCESTRY2 P2 (PREVOUTAT P (SKIPINS P 5 (+ J 0)))))

; PROOF must be my actual parent transaction, then either the genesis
; claim, my parent consumed the GENESIS outpoint at input 0 and I am
; its output 0, or the ancestry claim through the grandparent reveal.
; Both branches sit under the lazy if that pins PROOF, nothing is
; parsed before it hashes to (tx 11).
def (LINEAGE GENESIS PROOF PROOF2 PIDX) (if (= (hash256 PROOF) (tx 11)) (if PROOF2 (ANCESTRY PROOF PROOF2 PIDX) (all (<s (substr PROOF 4 5) 0x80) (= (substr PROOF 5 41) GENESIS) (= (tx 12) 0x00000000))))

; scan every output: F becomes one plus the index of the unique odd
; output, a second odd output raises
def (ODDSCAN I N F) (if (= I N) F (ODDSCAN (+ I 1) N (if (ODD8 (tx (rc I 20))) (if F (x "singleton: second odd output") (+ I 1)) F)))

; the unique odd output must recreate my scriptPubKey, zero odd
; outputs is the retire mode
def (CONT2 F) (if F (= (tx (rc (- F 1) 21)) (tx 16)) 1)

; no other input may be an odd output at my scriptPubKey, or two
; singleton chains would merge through one successor
def (INSCAN I N) (if (= I N) 1 (all (any (= I (tx 4)) (notall (= (tx (rc I 16)) (tx 16)) (ODD8 (tx (rc I 15))))) (INSCAN (+ I 1) N)))

; the main entry. all is eager, the pure checks come first and the
; raising checks carry their own messages, one refusal closes.
def (SINGLETON PROGHASH GENESIS INNER IARGS PROOF PROOF2 PIDX) (if (all (ODD8 (tx 15)) (LINEAGE GENESIS PROOF PROOF2 PIDX) (INSCAN 0 (tx 2)) (CONT2 (ODDSCAN 0 (tx 3) 0)) (MYPROG PROGHASH) (a INNER IARGS)) 1 (x "singleton: invalid spend"))

