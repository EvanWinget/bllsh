; context A: two outputs, first funding outpoint
tx 
tx_in_idx 0
tx_script 626c6c3a207032642064656d6f
utxos a086010000000000225120cbd9bf4a2e6de4f92206753f18f1ff7c0b71925a058311266041f2c0076b5abf

def SIGANYA 0x568cd2f0a4244d6d9cd7b684fc4c2052ce8027dcd0eac8970b2ada7b48c5c4da45be7ef4e046a9b792ffd5501575005e487b6bf758f5c72e2eb728305d15b7aa
def SIGCOVA 0x965398b4b647c8210c2cfda1b0f7cbf1fac9c0d02c42a4fe761316e2a2db33eb98f122afa538e0999274a86491ba0462528c940601b5dde7ffe986b67c080aa3
def SIGSOLA 0x86fa420063b170c6b69472cbd3e94bccd68ba8abf23d11ab2c7ca2d5c5d54274fd966277165ea856eec2221dede527edfaaa45fb0741cfe2fa0a7df9b1e201b4

; the signed allow-anything delegate authorizes the spend
eval (P2D (SYNPK) 0 (DELEGANY) 0 (SIGANYA))
; expect: 1

; the same delegate and the same signature with a different solution:
; the solution is not signed, only the delegate is
eval (P2D (SYNPK) 0 (DELEGANY) (q 1 2 3) (SIGANYA))
; expect: 1

; the covenant delegate checks the transaction it authorizes, this
; spend has the two outputs it demands
eval (P2D (SYNPK) 0 (DELEGCOV) 0 (SIGCOVA))
; expect: 1

; the solution-reading delegate constrains what the spender supplies
eval (P2D (SYNPK) 0 (DELEGSOL) 5 (SIGSOLA))
; expect: 1
eval (P2D (SYNPK) 0 (DELEGSOL) 6 (SIGSOLA))
; expect: ERR(Exception: 0x7032643a2064656c656761746564207370656e64206e6f7420617574686f72697a6564)

; a substituted delegate does not match the signed tree hash
eval (P2D (SYNPK) 0 (DELEGCOV) 0 (SIGANYA))
; expect: ERR(bip340_verify: invalid, non-empty signature)

; the hidden puzzle path is refused, it is taproot's script path here
eval (P2D (SYNPK) (SYNPK) (DELEGANY) 0 (SIGANYA))
; expect: ERR(Exception: 0x7032643a2068696464656e2070757a7a6c652070617468206e6f7420706f72746564)

; the same two authorized spends through the compiled program, the
; environment is the compiler's argument tree
; (((SYNPK . ORIGPK) . (DELEG . SOL)) . SIG)
blleval @P2D (((0x7a9375ad6167ad54aa74c6348cc54d344cc5dc9487d847049d5eabb0fa03c8fb . 0) . ((0 . 1) . 0)) . 0x568cd2f0a4244d6d9cd7b684fc4c2052ce8027dcd0eac8970b2ada7b48c5c4da45be7ef4e046a9b792ffd5501575005e487b6bf758f5c72e2eb728305d15b7aa)
; expect: 1
blleval @P2D (((0x7a9375ad6167ad54aa74c6348cc54d344cc5dc9487d847049d5eabb0fa03c8fb . 0) . ((14 (41 (0 . 3)) (0 . 2)) . 0)) . 0x965398b4b647c8210c2cfda1b0f7cbf1fac9c0d02c42a4fe761316e2a2db33eb98f122afa538e0999274a86491ba0462528c940601b5dde7ffe986b67c080aa3)
; expect: 1

