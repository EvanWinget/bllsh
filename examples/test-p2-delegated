
; test-p2-delegated - the delegation half of Chia's standard payment
; puzzle, ported to symbll
;
; Source: puzzles/p2_delegated_puzzle_or_hidden_puzzle.clsp from
; Chia-Network/chia_puzzles release 0.20.3
; (d122456feeef55708d354a065623037bfa010714). The coin owner signs a
; delegated program, graftroot style, and the spender runs it against
; arguments of their choosing. The signature covers the program, not
; the arguments and not the rest of the transaction, so the delegate
; alone decides what the spend may do.
;
; Block map from the source to this port:
;   mod parameters (SYNTHETIC_PUBLIC_KEY original_public_key
;     delegated_puzzle solution) -> def parameters (SYNPK ORIGPK
;     DELEG ARGS), plus an explicit SIG parameter
;   sha256tree1 -> SHA256TREE, the same algorithm: leaves hash under
;     a 1 prefix, pairs under a 2 prefix
;   is_hidden_puzzle_correct -> not ported, see below
;   possibly_prepend_aggsig -> the P2D body: the original_public_key
;     branch becomes the ORIGPK refusal, the AGG_SIG_ME condition
;     becomes the bip340_verify assertion, and prepending conditions
;     becomes requiring the delegate's result to be truthy
;   (a delegated_puzzle solution) -> (a DELEG ARGS)
;
; Deviations, each with its reason:
;   1. The hidden puzzle half is not ported. Revealing a pre-committed
;      alternative program is what taproot's script path provides by
;      construction, and is_hidden_puzzle_correct is the BIP341 tweak
;      equation itself: the synthetic key is the original key plus a
;      point derived from hashing the key with the program hash.
;      ORIGPK is kept as a parameter and any nonzero value is refused,
;      recording the unported branch in the program.
;   2. AGG_SIG_ME becomes bip340_verify over an explicit message, the
;      delegate's tree hash bound to the spent outpoint under the
;      bll/delegate tagged hash through SIGNMSG, the corpus
;      convention for explicit-message signatures. Chia appends the
;      coin id and a genesis challenge. The coin id becomes the
;      outpoint, and the genesis challenge's two jobs are covered
;      separately: the tagged hash keeps any other protocol's signed
;      messages from colliding with this one, and the outpoint binds
;      the network in practice, since it recurs on another chain only
;      if its entire funding ancestry recurs there. An application
;      needing unconditional network separation commits a network
;      identifier of its own. The signature itself is an explicit
;      argument, where Chia carries it in the spend bundle's BLS
;      aggregate.
;   3. The delegate does not return a conditions list for the
;      environment to enforce. It asserts transaction facts directly
;      through tx introspection and returns truthy, and P2D requires
;      that result.
;   4. The curried SYNTHETIC_PUBLIC_KEY becomes an explicit argument
;      tree entry, unbound under the legacy setter harness this
;      example still runs in. The commitment layout binds constants
;      quoted into a committed program body, the shape the singleton
;      port demonstrates, and moving this example onto that layout is
;      future corpus work.
;   5. Delegates are written in numeric bll opcodes. A quoted tree
;      containing symbols is not a bll value, so it cannot be applied
;      as a program.
;   6. The apply surface takes exactly two operands, program and
;      environment.
;
; All hex constants below were produced by
;   python3 examples/gen-test-context.py p2d
; The delegation signatures commit to the delegate's tree hash and
; the spent outpoint under the bll/delegate tagged hash, nothing
; else.
;
; Run with
;   python3 examples/run-examples.py examples/test-p2-delegated
; which checks every "; expect:" marker below, or interactively with
;   echo "import examples/test-p2-delegated" | ./bllsh
; Piping the file itself into the repl re-runs each command at every
; blank line (cmd.Cmd repeats the last command on an empty input line),
; the import command skips blank lines.

; shared taproot helpers, one vetted copy for the whole corpus, here
; for the TAGHASH signing discipline
import examples/lib-taproot

; the value the argument tree carries for the SYNPK parameter, the
; key that would be curried into the puzzle on Chia
def SYNPK 0x7a9375ad6167ad54aa74c6348cc54d344cc5dc9487d847049d5eabb0fa03c8fb

; the delegates, as quoted numeric bll programs
; DELEGANY is (q . 1): any spend is allowed
def DELEGANY (q 0 . 1)
; DELEGCOV is (= (tx 3) 2): the spend must have exactly two outputs,
; the output count is a minimal int so = is safe here
def DELEGCOV (q 14 (41 (0 . 3)) (0 . 2))
; DELEGARG is (= 1 (q . 5)) with 1 the whole environment: the
; delegate's argument must be the atom 5
def DELEGARG (q 14 1 (0 . 5))

; sha256tree1 from the source: hash a program tree, leaves under a
; 1 prefix, pairs under a 2 prefix
def (SHA256TREE T) (if (l T) (sha256 2 (SHA256TREE (h T)) (SHA256TREE (t T))) (sha256 1 T))

; possibly_prepend_aggsig and the main entry point in one body. The
; ORIGPK branch is the unported hidden puzzle half. The signature
; check raises on a bad signature and the delegate raises or returns
; nil on refusal, so all is safe even though it is eager.
def (P2D SYNPK ORIGPK DELEG ARGS SIG) (if ORIGPK (x "p2d: hidden path not ported") (if (all (bip340_verify SYNPK (SIGNMSG "bll/delegate" (SHA256TREE DELEG)) SIG) (a DELEG ARGS)) 1 (x "p2d: delegated spend not authorized")))

; the tree hashes the signatures below commit to, pinned against the
; generator's Python computation
eval (SHA256TREE (DELEGANY))
; expect: 0xc92b0c6bcabde5fa4d0d37cc741c5c50fe019e4eeacea5d8fd7385f672e2c3f3
eval (SHA256TREE (DELEGCOV))
; expect: 0x0393e38f7b9973c3a0320390d0cc48d6cccc2c8cc09a2ebc4cd3aa207e3509e7
eval (SHA256TREE (DELEGARG))
; expect: 0x93ed957ea9e265231e1c240618111e2e505b3d55a94039799e14741ffc969758

; -------------------------------------------------------------------
; context A: two outputs, first funding outpoint
tx 
tx_in_idx 0
tx_script 626c6c3a207032642064656d6f
utxos a086010000000000225120cbd9bf4a2e6de4f92206753f18f1ff7c0b71925a058311266041f2c0076b5abf

def SIGANYA 0x7a9e8326c177544777789df16c8579ad52463032762b3a88a530e3428b694a076a8045f3c637d3fdba6acf4fb4784f88ebb8ad02b7714d99253e59643dd90ef7
def SIGCOVA 0x2e00f98c15db337fd5ab8a6fce0523c947bb0745f0d78f33629cf40286af2c16b20407e21e83318a1ea9dd79e1552c332c62dbc018e81a2ac66e94fd504cbb19
def SIGARGA 0x2879bef492430362188068bd4646a3215981bd263e5426760d37ef3dd1f302178c8ee91b698024f24b176b60da730d2d2ec80e8c2ee673f8fcee1d64241b13c4

; the signed allow-anything delegate authorizes the spend
eval (P2D (SYNPK) 0 (DELEGANY) 0 (SIGANYA))
; expect: 1

; the same delegate and the same signature with different arguments:
; the arguments are not signed, only the delegate is
eval (P2D (SYNPK) 0 (DELEGANY) (q 1 2 3) (SIGANYA))
; expect: 1

; the covenant delegate checks the transaction it authorizes, this
; spend has the two outputs it demands
eval (P2D (SYNPK) 0 (DELEGCOV) 0 (SIGCOVA))
; expect: 1

; the argument-reading delegate constrains what the spender supplies
eval (P2D (SYNPK) 0 (DELEGARG) 5 (SIGARGA))
; expect: 1
eval (P2D (SYNPK) 0 (DELEGARG) 6 (SIGARGA))
; expect: ERR(Exception: 0x7032643a2064656c656761746564207370656e64206e6f7420617574686f72697a6564)

; a substituted delegate does not match the signed tree hash
eval (P2D (SYNPK) 0 (DELEGCOV) 0 (SIGANYA))
; expect: ERR(bip340_verify: invalid, non-empty signature)

; the hidden path is refused, it is taproot's script path here
eval (P2D (SYNPK) (SYNPK) (DELEGANY) 0 (SIGANYA))
; expect: ERR(Exception: 0x7032643a2068696464656e2070617468206e6f7420706f72746564)

; the same two authorized spends through the compiled program, the
; environment is the compiler's argument tree
; (((SYNPK . ORIGPK) . (DELEG . ARGS)) . SIG)
blleval @P2D (((0x7a9375ad6167ad54aa74c6348cc54d344cc5dc9487d847049d5eabb0fa03c8fb . 0) . ((0 . 1) . 0)) . 0x7a9e8326c177544777789df16c8579ad52463032762b3a88a530e3428b694a076a8045f3c637d3fdba6acf4fb4784f88ebb8ad02b7714d99253e59643dd90ef7)
; expect: 1
blleval @P2D (((0x7a9375ad6167ad54aa74c6348cc54d344cc5dc9487d847049d5eabb0fa03c8fb . 0) . ((14 (41 (0 . 3)) (0 . 2)) . 0)) . 0x2e00f98c15db337fd5ab8a6fce0523c947bb0745f0d78f33629cf40286af2c16b20407e21e83318a1ea9dd79e1552c332c62dbc018e81a2ac66e94fd504cbb19)
; expect: 1

