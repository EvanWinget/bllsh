def SIGCOVB 0x0ea73ad060864729b9407b5fdaa79e7ff0bbfe18b275b7b8cd99a90d11e0aad6305fac3d655b3ed665d8fd8ee01edbea4c7e7a90d9fa68fbbb5a4581d8c0fb2d

; a valid signature does not help when the covenant delegate refuses
; the transaction, this spend has one output where it demands two
eval (P2D (SYNPK) 0 (DELEGCOV) 0 (SIGCOVB))
; expect: ERR(Exception: 0x7032643a2064656c656761746564207370656e64206e6f7420617574686f72697a6564)

; a delegation signature is bound to its outpoint, context A's
; signature is refused on context B's funding outpoint
eval (P2D (SYNPK) 0 (DELEGANY) 0 (SIGANYA))
; expect: ERR(bip340_verify: invalid, non-empty signature)

