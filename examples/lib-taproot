
; lib-taproot - shared taproot reconstruction helpers for the corpus
;
; Corpus examples pull these defs in with
;   import examples/lib-taproot
; the way a Chialisp module includes a .clib file. The defs land in
; the repl symbol table and compile into each program that uses them,
; so committed programs stay standalone. The block originated in the
; upstream test-taproot demo, which keeps its own copy.

; varint and tagged hash building blocks
def (VARINT2 N) (if (< N 253) (substr N 0 1) (cat 0xFD (substr (cat N 0x000000) 0 2)))
def (VARSTR S) (cat (VARINT2 (strlen S)) S)

def (TAGHASH2 SHATAG DATA) (sha256 SHATAG SHATAG DATA)
def (TAGHASH TAG DATA) (TAGHASH2 (sha256 TAG) DATA)

; BIP341 leaf, branch, path and output key reconstruction. TAPROOT
; proves SPK is the x-only output key for the given leaf hash, merkle
; path and internal key, raising through secp256k1_muladd on a
; mismatch.
def (TAPLEAF V SCRIPT) (TAGHASH "TapLeaf" (cat V (VARSTR SCRIPT)))
def (TAPBRANCH A B) (TAGHASH "TapBranch" (if (<s A B) (cat A B) (cat B A)))
def (TAPPATH IPK PATH LEAF) (if PATH (TAPPATH IPK (substr PATH 32) (TAPBRANCH LEAF (substr PATH 0 32))) (TAGHASH "TapTweak" (cat IPK LEAF)))

def (TAPROOT SPKODD LEAFHASH PATH IPK SPK) (secp256k1_muladd (TAPPATH IPK PATH LEAFHASH) (rc IPK 1) (rc SPK SPKODD))

; strip the 0x5120 taproot prefix from a scriptPubKey, raising if it
; is not a taproot output
def (CHECKTAPSPK SPK) (if (= (substr SPK 0 2) 0x5120) (substr SPK 2) (x))
