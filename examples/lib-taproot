
; lib-taproot - shared taproot reconstruction and commitment
; exclusivity helpers for the corpus
;
; Corpus examples pull these defs in with
;   import examples/lib-taproot
; from the repository root, the way a Chialisp module includes a
; .clib file. The defs land in the repl symbol table and compile into
; each program that uses them, so committed programs stay standalone.
; The block originated in the upstream test-taproot demo, which keeps
; its own copy along with the leaf hashing defs no corpus program
; needs, every corpus reconstruction starts from the introspected
; leaf hash (tx 6).

; tagged hash building blocks
def (TAGHASH2 SHATAG DATA) (sha256 SHATAG SHATAG DATA)
def (TAGHASH TAG DATA) (TAGHASH2 (sha256 TAG) DATA)

; BIP341 branch, path and output key reconstruction. TAPROOT proves
; SPK is the x-only output key for the given leaf hash, merkle path
; and internal key, raising through secp256k1_muladd on a mismatch.
def (TAPBRANCH A B) (TAGHASH "TapBranch" (if (<s A B) (cat A B) (cat B A)))
def (TAPPATH IPK PATH LEAF) (if PATH (TAPPATH IPK (substr PATH 32) (TAPBRANCH LEAF (substr PATH 0 32))) (TAGHASH "TapTweak" (cat IPK LEAF)))

def (TAPROOT SPKODD LEAFHASH PATH IPK SPK) (secp256k1_muladd (TAPPATH IPK PATH LEAFHASH) (rc IPK 1) (rc SPK SPKODD))

; strip the 0x5120 taproot prefix from a scriptPubKey, raising if it
; is not a taproot output
def (CHECKTAPSPK SPK) (if (= (substr SPK 0 2) 0x5120) (substr SPK 2) (x))

; the BIP341 unspendable internal key, the x coordinate of a point
; with no known discrete logarithm, so an output naming it as the
; internal key has no key path
def UNSPENDABLEIPK 0x50929b74c1a04954b78b4b6035e97a5e078a5a0f28ec96d547bfee9ace803ac0

; the executing leaf is the only spend path of the spent output.
; BIP341 validation already verified this control block against the
; spent scriptPubKey, so an empty merkle path means a single leaf
; tree and the unspendable internal key means no key path.
def (SOLELEAF) (all (= (tx 8) 0) (= (tx 7) (UNSPENDABLEIPK)))
